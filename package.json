{
  "name": "better-auth-typeorm-adapter",
  "version": "1.2.1",
  "description": "TypeORM adapter for Better Auth - Full-featured database adapter with TypeScript support | Suporte: lucas@uvvipay.com.br | Twitter: @olucasrat",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "npm run test:unit && npm run test:adapter",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/index.test.ts",
    "test:adapter": "vitest run"
  },
  "keywords": [
    "better-auth",
    "typeorm",
    "adapter",
    "authentication",
    "postgres",
    "mysql",
    "database",
    "orm",
    "typescript"
  ],
  "author": "Lucas Ratnieks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luratnieks/better-auth-typeorm-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/luratnieks/better-auth-typeorm-adapter/issues"
  },
  "homepage": "https://github.com/luratnieks/better-auth-typeorm-adapter#readme",
  "peerDependencies": {
    "better-auth": "^1.6.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@better-auth/test-utils": "^1.6.23",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "better-auth": "^1.3.27",
    "better-sqlite3": "^12.11.1",
    "tsup": "^8.5.1",
    "typeorm": "^0.3.27",
    "typescript": "^5.1.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "module": "dist/index.mjs"
}
